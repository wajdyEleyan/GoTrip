# GoTrip Backend-Proxy Environment Variables
# Kopiere diese Datei zu .env und trage deine Keys ein

EARTHDATA_TOKEN=YOUR_TOKEN

# NASA Earthdata Login Token (optional, für CMR-Satellitendaten)
# Erstellen: https://urs.earthdata.nasa.gov/profile  → "Generate Token"
EARTHDATA_TOKEN=eyJ...

PORT=3001
